{
  "name": "ai-companion",
  "version": "1.0.0",
  "description": "A local desktop companion for Codex and Claude: usage analytics, a floating widget, and input alerts.",
  "productName": "AI Companion",
  "scripts": {
    "dev": "tauri dev",
    "dev:ui": "vite",
    "build": "tauri build --no-bundle",
    "build:ui": "vite build",
    "start": "node scripts/start.cjs",
    "dist:win": "tauri build --bundles nsis",
    "test": "node scripts/test.cjs && cargo test --manifest-path src-tauri/Cargo.toml && node scripts/parity.cjs",
    "test:parity": "node scripts/parity.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.check.json"
  },
  "keywords": [
    "codex",
    "claude",
    "companion",
    "usage",
    "rust",
    "tauri"
  ],
  "author": "AI Companion contributors",
  "license": "ISC",
  "dependencies": {
    "date-fns": "^4.1.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.8.1",
    "@tauri-apps/api": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.2",
    "vite": "^7.3.2",
    "@tauri-apps/cli": "^2.0.0",
    "esbuild": "^0.25.0"
  }
}
